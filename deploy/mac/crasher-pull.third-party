# digitorus/pkcs7 are the third-party libraries named in COMMON-RULES). Andrei: check them
# against `ls ~/lane/crashers/` on the hosts or swap this file for the registry before
# the first real pull. A target missing here is pulled normally, just without the marker.
saml
pkcs7
