[Unit]
Description=DashDiag continuous fuzzer (fuzz-harness runner)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=andrei
WorkingDirectory=/home/andrei/proj/dashdiag
Environment=HOME=/home/andrei
Environment=PATH=/snap/go/current/bin:/usr/bin:/bin
Environment=GOPATH=/home/andrei/go
# Uses the shared runner copy; its config is $SCRIPT_DIR/fuzz.conf =
# /home/andrei/proj/fuzz-harness/fuzz.conf (the DashDiag conf on this box).
ExecStart=/home/andrei/proj/fuzz-harness/fuzz-runner.sh
Restart=on-failure
RestartSec=30
# Shared box (also runs libs-extra-fuzz); 3000M each keeps the pair under RAM.
MemoryMax=3000M
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dashdiag-fuzz

[Install]
WantedBy=multi-user.target
